# Réglages locaux du lab (modèle). install.sh en fait un config.env dans le dossier du lab (le clone),
# en remplaçant les marqueurs @…@ ; ce fichier est ensuite à vous, ignoré par git (jamais poussé).
# Lu (source) par tous les scripts : uniquement des affectations, pas de commande.

# --- Chemins (propres à chaque machine) -------------------------------------------------------------
RACINE="@RACINE@"                  # portée de lecture des permissions du manageur (par défaut : le lab lui-même)
LAB="@LAB@"                          # le lab lui-même = le clone du dépôt (scripts, agents, config, reports…)
WORKTREES="@WORKTREES@"            # copies de travail (une par projet) où les rounds écrivent (défaut : data/worktrees)
PROJETS="@PROJETS@"                # clones des projets, lecture seule pour le manageur (défaut : data/projects)
LOGS="@LOGS@"                      # journaux des rounds et des LaunchAgents (défaut : data/logs)
BREW_BIN="@BREW_BIN@"              # dossier des outils Homebrew (gtimeout, flock, tmux, gh…)
PREFIXE_LAUNCHAGENT="@PREFIXE_LAUNCHAGENT@"   # préfixe des étiquettes launchd (<préfixe>.manager, <préfixe>.now…)

# --- Cerveau (modèle) : trois niveaux, priorité agent > projet > lab ------------------------------------
# lab : défaut de toute l'installation (ici). Projet : clé MODELE="…" de config/projects/<projet>.env.
# Agent : champ « model: » de agents/<nom>.md (« inherit » = suit le projet, puis le lab). Voir README.md.
MODELE_LAB="sonnet"                 # modèle des rounds (chef de nuit + sous-agents qui n'ont pas de model:)
MODELE_MANAGER="opus"              # modèle de la session du manageur (manager.sh, direct-session.sh)
export ANTHROPIC_MODEL="$MODELE_LAB"   # repris par night.sh, qui y met le modèle du projet s'il y en a un
export CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS=0   # claude -p attend les sous-agents lancés en arrière-plan (sinon tués après 10 min) ; durée bornée par TIMEOUT_ROUND

# --- Rounds -----------------------------------------------------------------------------------------
TIMEOUT_ROUND="210m"      # durée max d'un round (3 h 30) — suffixe unique obligatoire
VERROU_ROUND="@VERROU_ROUND@"   # verrou : un seul round à la fois sur la machine (night-chain.sh, morning.sh) ; install.sh --lock le rend aussi dans le LaunchAgent now
MAX_TURNS=150            # nombre max d'échanges par round
PUSH_BRANCHES="oui"       # pousser les branches claude/* après chaque round
OUVRIR_PR="oui"           # ouvrir une PR en brouillon si la branche n'en a pas encore
DERNIER_DEPART="04:00"    # dernier départ d'un round de nuit (premier essai ou reprise), testé avant chaque départ (+5 min de tolérance), 00:00 à 11:59
PREMIER_DEPART="23:00"    # aucun départ de nuit avant cette heure le soir (lancement au réveil de la machine l'après-midi : rien), 12:00 à 23:59
# Aucun plafond de rounds (décision D2) : la chaîne de nuit enchaîne les sections « ## ROUND N » de config/TASKS.md jusqu'à la première absente (99 au plus).
